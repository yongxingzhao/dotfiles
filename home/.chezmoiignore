# 全局忽略：缓存/生成文件（所有主机都忽略，避免污染 git）
***/.compiled.cache.glsl
**/.gitignore

# 仅 YoXi-Arch 生效，其他主机全部隐藏
{{- if ne .chezmoi.hostname "YoXi-Arch" }}
.config/hyde
.config/hypr
.config/waybar
.config/fcitx5
.local/share/fcitx5
{{- end }}

# 仅 YoXi-Mac 生效，其他主机（含 Arch）不部署 macOS 专用覆盖
{{- if ne .chezmoi.hostname "YoXi-Mac" }}
.config/ghostty/config.darwin
{{- end }}

# 仅 YoXi-Arch 生效，Mac 不部署 Linux 专属优化
{{- if ne .chezmoi.hostname "YoXi-Arch" }}
.config/ghostty/config.linux
{{- end }}

# Kitty 按主机加载：arch.conf 仅 Arch、darwin.conf 仅 Mac
# 共享 kitty.conf 用 globinclude kitty.d/*.conf 拉取，
# 各主机只部署自己的 delta 文件，确保 glob 只匹配到对应文件。
{{- if ne .chezmoi.hostname "YoXi-Arch" }}
.config/kitty/kitty.d/arch.conf
{{- end }}
{{- if ne .chezmoi.hostname "YoXi-Mac" }}
.config/kitty/kitty.d/darwin.conf
{{- end }}
