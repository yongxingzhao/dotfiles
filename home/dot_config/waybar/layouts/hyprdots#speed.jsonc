//   --// user layout: hyprdots/06 + wifi 模块默认显示网速、点击切回图标 //--   //
// 基于 ~/.local/share/waybar/layouts/hyprdots/06.jsonc 复制修改，放在用户目录，HyDE 升级不覆盖。
// 改动：group/pill#right1 里 "network" -> "network#speed"
//       （network#speed 定义在 ~/.config/waybar/modules/network-speed.jsonc：
//         format-wifi = 网速（默认显示），format-alt = wifi 图标（点击切换））
{
    // sourced from header module //
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*", 
        "$XDG_CONFIG_HOME/waybar/includes/includes.json" 
    ],
    // positions generated based on config.ctl //
    "modules-left": [
        "group/pill#left1",
        "group/pill#left2"
    ],
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces",
            "hyprland/window"
        ]
    },
    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "custom/caffeine",
            "clock"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
            "custom/cpuinfo",
            "custom/gpuinfo"
        ]
    },
    "modules-right": [
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3"
    ],
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network#speed",
            "pulseaudio",
            "pulseaudio#microphone",
            "custom/updates",
            "custom/keybindhint",
            "custom/weather"
        ]
    },
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "privacy",
            "tray",
            "battery"
        ]
    },
    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/wallchange",
            "custom/theme",
            "custom/wbar",
            "custom/cliphist",
            "custom/hyde-menu",
            "custom/power"
        ]
    }
}
